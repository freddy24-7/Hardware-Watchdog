# ============================================================
# Hardware Watchdog — environment variable reference
# Copy to .env and fill in values before running docker compose
# ============================================================

# ----- Kafka ------------------------------------------------

# Type: string (host:port, comma-separated for multiple brokers)
# Default: kafka:9092
# Used by: agent, consumer
# Description: Bootstrap broker address(es) for the Kafka cluster.
KAFKA_BROKERS=kafka:9092

# Type: string
# Default: hw.metrics
# Used by: agent, consumer
# Description: Kafka topic name for hardware metric events.
KAFKA_TOPIC=hw.metrics

# Type: string
# Default: hw-watchdog
# Used by: consumer
# Description: Kafka consumer group ID; all consumer instances share this group.
KAFKA_GROUP_ID=hw-watchdog

# Type: string
# Default: PLAINTEXT
# Used by: agent
# Description: Kafka security protocol. Use SASL_SSL for cloud brokers (Redpanda, Confluent).
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Type: string
# Default: SCRAM-SHA-256
# Used by: agent
# Description: SASL mechanism. SCRAM-SHA-256 or SCRAM-SHA-512.
KAFKA_SASL_MECHANISM=SCRAM-SHA-256

# Type: string
# Default: (unset — SASL disabled)
# Used by: agent
# Description: SASL username. Required when KAFKA_SECURITY_PROTOCOL=SASL_SSL.
KAFKA_SASL_USERNAME=

# Type: string
# Default: (unset — SASL disabled)
# Used by: agent
# Description: SASL password. Required when KAFKA_SECURITY_PROTOCOL=SASL_SSL.
KAFKA_SASL_PASSWORD=

# ----- Agent ------------------------------------------------

# Type: u64 (positive integer, seconds)
# Default: 5
# Used by: agent
# Description: How often the agent collects and publishes a metrics snapshot.
METRICS_INTERVAL_SECS=5

# ----- Consumer ---------------------------------------------

# Type: usize (positive integer, row count)
# Default: 50
# Used by: consumer
# Description: Maximum number of metric rows to buffer before flushing to Postgres.
CONSUMER_BATCH_SIZE=50

# Type: u64 (positive integer, milliseconds)
# Default: 2000
# Used by: consumer
# Description: Maximum time to wait before flushing a partial batch to Postgres.
CONSUMER_BATCH_TIMEOUT_MS=2000

# ----- PostgreSQL -------------------------------------------

# Type: string (PostgreSQL connection URL)
# Default: (required)
# Used by: consumer
# Description: Full connection URL including credentials, host, port, and database name.
DATABASE_URL=postgres://watchdog:watchdog@postgres:5432/watchdog

# Type: string
# Default: watchdog
# Used by: docker-compose (postgres service)
# Description: PostgreSQL superuser / application username.
POSTGRES_USER=watchdog

# Type: string
# Default: watchdog
# Used by: docker-compose (postgres service)
# Description: PostgreSQL password for POSTGRES_USER.
POSTGRES_PASSWORD=watchdog

# Type: string
# Default: watchdog
# Used by: docker-compose (postgres service)
# Description: Name of the PostgreSQL database to create on first boot.
POSTGRES_DB=watchdog

# ----- Grafana ----------------------------------------------

# Type: string
# Default: admin
# Used by: grafana service
# Description: Password for the Grafana admin user.
GF_SECURITY_ADMIN_PASSWORD=admin

# ----- Logging ----------------------------------------------

# Type: string (tracing filter directive)
# Default: info
# Used by: agent, consumer
# Description: Log level / filter. Examples: info, debug, agent=debug,consumer=info
RUST_LOG=info
