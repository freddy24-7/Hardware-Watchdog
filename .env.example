# ============================================================
# Hardware Watchdog — environment variable reference
# Copy to .env and fill in values before running docker compose
# ============================================================

# ----- Agent ------------------------------------------------

# Type: string (URL)
# Default: http://ingest:8080/ingest
# Used by: agent
# Description: Full URL of the ingest endpoint. Override with the Railway URL for cloud deployments.
INGEST_URL=http://ingest:8080/ingest

# Type: u64 (seconds)
# Default: 5
# Used by: agent
# Description: How often the agent collects and sends a metrics snapshot.
METRICS_INTERVAL_SECS=5

# ----- Ingest service ---------------------------------------

# Type: string (PostgreSQL connection URL)
# Default: postgres://watchdog:watchdog@postgres:5432/watchdog
# Used by: ingest
# Description: Full connection URL including credentials, host, port, and database name.
DATABASE_URL=postgres://watchdog:watchdog@postgres:5432/watchdog

# Type: u16 (port number)
# Default: 8080
# Used by: ingest
# Description: TCP port the HTTP ingest server listens on.
PORT=8080

# ----- PostgreSQL -------------------------------------------

# Type: string
# Default: watchdog
# Used by: docker-compose (postgres service)
POSTGRES_USER=watchdog

# Type: string
# Default: watchdog
# Used by: docker-compose (postgres service)
POSTGRES_PASSWORD=watchdog

# Type: string
# Default: watchdog
# Used by: docker-compose (postgres service)
POSTGRES_DB=watchdog

# ----- Grafana ----------------------------------------------

# Type: string
# Default: admin
# Used by: grafana service
# Description: Password for the Grafana admin user.
GF_SECURITY_ADMIN_PASSWORD=admin

# ----- Logging ----------------------------------------------

# Type: string (tracing filter directive)
# Default: info
# Used by: agent, ingest
# Description: Log level / filter. Examples: info, debug, agent=debug
RUST_LOG=info
